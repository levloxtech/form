PORT=5000

# Comma-separated list of allowed frontends
CLIENT_ORIGINS=http://localhost:5173,https://your-site.vercel.app

# Where applications are delivered
TO_EMAIL=levloxtech@gmail.com

# --- Option A: Gmail SMTP (use a Google App Password, NOT your login password) ---
GMAIL_USER=levloxtech@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Option B: Resend HTTP API (recommended on Render free tier, SMTP is blocked there) ---
# If RESEND_API_KEY is set, it is used instead of Gmail.
RESEND_API_KEY=
RESEND_FROM=LevLox Tech <onboarding@resend.dev>

# Send an auto-confirmation to the applicant (needs a verified domain on Resend)
SEND_CONFIRMATION=false
